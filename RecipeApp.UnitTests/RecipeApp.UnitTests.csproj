<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <!-- First reference to Infrastructure from this test project pulls EF Core transitively at
         its 10.0.4 floor, mismatching Infrastructure's 10.0.9 (CS1705). Pin to 10.0.9 to match
         (Decisions/dotnet-test-project-ef-core-pinning.md). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.9" />
    <!-- AuthServiceLoginTests: a real ApplicationDbContext over the InMemory provider (the
         relational-only jsonb/default-value annotations are ignored there). Same 10.0.9
         pin as Relational above. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.9" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RecipeApp.Application\RecipeApp.Application.csproj" />
    <ProjectReference Include="..\RecipeApp.Domain\RecipeApp.Domain.csproj" />
    <ProjectReference Include="..\RecipeApp.Infrastructure\RecipeApp.Infrastructure.csproj" />
    <!-- AliasMergeTests. The seed builder is a by-hand tool and stays out of RecipeApp.slnx as
         a top-level project, but its MERGE step decides what enters IngredientAliases — and an
         alias sets ingredient identity, which is the thing IngredientKey's no-fuzzy-matching
         prohibition protects. Referencing it here puts that one gate under
         `dotnet test RecipeApp.slnx`. Nothing else in the tool is exercised, and no USDA data
         is read: only the pure merge rules run. -->
    <ProjectReference Include="..\tools\IngredientSeedBuilder\IngredientSeedBuilder.csproj" />
  </ItemGroup>

</Project>